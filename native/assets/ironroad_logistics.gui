types ironroad_logistics
{
    type ironroad_state_freight_cell = widget {
        size = { 60 50 }
        tooltip = "IRONROAD_STATE_GOOD_TOOLTIP"
        button = {
            using = default_button
            size = { 60 50 }
            enabled = "[And3(GetVariableSystem.Exists('ironroad_state_controls_id_v1'), EqualTo_string(GetVariableSystem.Get('ironroad_state_controls_id_v1'), State.GetIDString), Not(EqualTo_string(GetVariableSystem.Get('ironroad_state_good_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), Concatenate(':', Goods.GetKey)))))]"
            onclick = "[GetVariableSystem.Set('ironroad_state_good_v1', Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), Concatenate(':', Goods.GetKey)))]"
            textbox = {
                visible = "[And3(GetVariableSystem.Exists('ironroad_state_rows_id_v1'), EqualTo_string(GetVariableSystem.Get('ironroad_state_rows_id_v1'), State.GetIDString), GetVariableSystem.Exists(Concatenate('ironroad_state_work_', Concatenate(State.GetIDString, Concatenate('_', Goods.GetKey)))))]"
                raw_text = "[GetVariableSystem.Get(Concatenate('ironroad_state_work_', Concatenate(State.GetIDString, Concatenate('_', Goods.GetKey))))]"
                size = { 60 50 }
                align = center
                using = elide_fontsize_min
            }
            textbox = {
                visible = "[Not(And3(GetVariableSystem.Exists('ironroad_state_rows_id_v1'), EqualTo_string(GetVariableSystem.Get('ironroad_state_rows_id_v1'), State.GetIDString), GetVariableSystem.Exists(Concatenate('ironroad_state_work_', Concatenate(State.GetIDString, Concatenate('_', Goods.GetKey))))))]"
                raw_text = "--"
                size = { 60 50 }
                align = center
            }
        }
    }
    type ironroad_state_filters = flowcontainer {
        using = default_list_position
        direction = vertical
        spacing = 4
        visible = "[And3(GetVariableSystem.Exists('ironroad_state_context_v1'), GetVariableSystem.Exists('ironroad_state_controls_id_v1'), EqualTo_string(GetVariableSystem.Get('ironroad_state_controls_id_v1'), State.GetIDString))]"
        tooltip = "IRONROAD_STATE_FILTER_TOOLTIP"
        flowcontainer = {
            spacing = 6
            textbox = { text = "IRONROAD_MAP" size = { 55 32 } align = center }
            button = {
                using = default_button
                size = { 95 32 }
                enabled = "[Not(EqualTo_string(GetVariableSystem.Get('ironroad_state_direction_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':all')))]"
                onclick = "[GetVariableSystem.Set('ironroad_state_direction_v1', Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':all'))]"
                textbox = { text = "IRONROAD_BOTH_DIRECTIONS" parentanchor = center size = { 100% 100% } align = center alwaystransparent = yes using = elide_fontsize_min }
            }
            button = {
                using = default_button
                size = { 95 32 }
                enabled = "[Not(EqualTo_string(GetVariableSystem.Get('ironroad_state_direction_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':imports')))]"
                onclick = "[GetVariableSystem.Set('ironroad_state_direction_v1', Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':imports'))]"
                textbox = { text = "IRONROAD_IMPORTS" parentanchor = center size = { 100% 100% } align = center alwaystransparent = yes using = elide_fontsize_min }
            }
            button = {
                using = default_button
                size = { 95 32 }
                enabled = "[Not(EqualTo_string(GetVariableSystem.Get('ironroad_state_direction_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':exports')))]"
                onclick = "[GetVariableSystem.Set('ironroad_state_direction_v1', Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':exports'))]"
                textbox = { text = "IRONROAD_EXPORTS" parentanchor = center size = { 100% 100% } align = center alwaystransparent = yes using = elide_fontsize_min }
            }
            button = {
                using = default_button
                size = { 160 32 }
                enabled = "[Not(EqualTo_string(GetVariableSystem.Get('ironroad_state_good_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':all')))]"
                onclick = "[GetVariableSystem.Set('ironroad_state_good_v1', Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':all'))]"
                textbox = { text = "IRONROAD_ALL_GOODS" parentanchor = center size = { 100% 100% } align = center alwaystransparent = yes using = elide_fontsize_min }
            }
        }
        flowcontainer = {
            spacing = 6
            textbox = { text = "IRONROAD_SEGMENTS" size = { 55 32 } align = center }
            button = {
                using = default_button
                size = { 95 32 }
                enabled = "[Not(EqualTo_string(GetVariableSystem.Get('ironroad_state_transport_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':all')))]"
                onclick = "[GetVariableSystem.Set('ironroad_state_transport_v1', Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':all'))]"
                textbox = { text = "IRONROAD_ALL_TRANSPORT" parentanchor = center size = { 100% 100% } align = center alwaystransparent = yes using = elide_fontsize_min }
            }
            button = {
                using = default_button
                size = { 95 32 }
                enabled = "[Not(EqualTo_string(GetVariableSystem.Get('ironroad_state_transport_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':land')))]"
                onclick = "[GetVariableSystem.Set('ironroad_state_transport_v1', Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':land'))]"
                textbox = { text = "IRONROAD_LAND" parentanchor = center size = { 100% 100% } align = center alwaystransparent = yes using = elide_fontsize_min }
            }
            button = {
                using = default_button
                size = { 95 32 }
                enabled = "[Not(EqualTo_string(GetVariableSystem.Get('ironroad_state_transport_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':sea')))]"
                onclick = "[GetVariableSystem.Set('ironroad_state_transport_v1', Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':sea'))]"
                textbox = { text = "IRONROAD_SEA" parentanchor = center size = { 100% 100% } align = center alwaystransparent = yes using = elide_fontsize_min }
            }
            textbox = { text = "IRONROAD_PICK_GOOD" size = { 160 32 } align = center using = elide_fontsize_min }
        }
        flowcontainer = {
            spacing = 6
            textbox = { text = "IRONROAD_COLOR" size = { 55 32 } align = center }
            button = {
                using = default_button
                size = { 95 32 }
                enabled = "[Not(EqualTo_string(GetVariableSystem.Get('ironroad_state_color_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':all')))]"
                onclick = "[GetVariableSystem.Set('ironroad_state_color_v1', Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':all'))]"
                textbox = { text = "IRONROAD_COLOR_STATE" parentanchor = center size = { 100% 100% } align = center alwaystransparent = yes using = elide_fontsize_min }
            }
            button = {
                using = default_button
                size = { 95 32 }
                enabled = "[Not(EqualTo_string(GetVariableSystem.Get('ironroad_state_color_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':goods')))]"
                onclick = "[GetVariableSystem.Set('ironroad_state_color_v1', Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':goods'))]"
                textbox = { text = "IRONROAD_COLOR_GOODS" parentanchor = center size = { 100% 100% } align = center alwaystransparent = yes using = elide_fontsize_min }
            }
            button = {
                using = default_button
                size = { 95 32 }
                enabled = "[Not(EqualTo_string(GetVariableSystem.Get('ironroad_state_color_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':native')))]"
                onclick = "[GetVariableSystem.Set('ironroad_state_color_v1', Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':native'))]"
                textbox = { text = "IRONROAD_COLOR_NATIVE" parentanchor = center size = { 100% 100% } align = center alwaystransparent = yes using = elide_fontsize_min }
            }
            textbox = { text = "IRONROAD_COLOR_MODES" size = { 160 32 } align = center using = elide_fontsize_min }
        }
        ironroad_flow_legend = {}
    }
    type ironroad_flow_legend = flowcontainer {
        direction = vertical
        spacing = 2
        textbox = {
            text = "IRONROAD_LEGEND_STATE"
            visible = "[And(InformationPanel.IsTabSelected('local_goods'), EqualTo_string(GetVariableSystem.Get('ironroad_state_color_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':all')))]"
            size = { 530 26 }
            tooltip = "IRONROAD_LEGEND_STATE_TOOLTIP"
            using = elide_fontsize_min
        }
        textbox = {
            text = "IRONROAD_LEGEND_MARKET"
            visible = "[And(InformationPanel.IsTabSelected('ironroad_logistics'), EqualTo_string(GetVariableSystem.Get('ironroad_market_color_v1'), Concatenate(GetVariableSystem.Get('ironroad_hover_context_v1'), ':all')))]"
            size = { 530 26 }
            tooltip = "IRONROAD_LEGEND_MARKET_TOOLTIP"
            using = elide_fontsize_min
        }
        textbox = {
            text = "IRONROAD_LEGEND_GOODS"
            visible = "[Or(And(InformationPanel.IsTabSelected('local_goods'), EqualTo_string(GetVariableSystem.Get('ironroad_state_color_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':goods'))), And(InformationPanel.IsTabSelected('ironroad_logistics'), EqualTo_string(GetVariableSystem.Get('ironroad_market_color_v1'), Concatenate(GetVariableSystem.Get('ironroad_hover_context_v1'), ':goods'))))]"
            size = { 530 26 }
            tooltip = "IRONROAD_LEGEND_GOODS_TOOLTIP"
            using = elide_fontsize_min
        }
        textbox = {
            text = "IRONROAD_LEGEND_NATIVE"
            visible = "[Or(And(InformationPanel.IsTabSelected('local_goods'), EqualTo_string(GetVariableSystem.Get('ironroad_state_color_v1'), Concatenate(GetVariableSystem.Get('ironroad_state_context_v1'), ':native'))), And(InformationPanel.IsTabSelected('ironroad_logistics'), EqualTo_string(GetVariableSystem.Get('ironroad_market_color_v1'), Concatenate(GetVariableSystem.Get('ironroad_hover_context_v1'), ':native'))))]"
            size = { 530 26 }
            tooltip = "IRONROAD_LEGEND_NATIVE_TOOLTIP"
            using = elide_fontsize_min
        }
        flowcontainer = {
            spacing = 10
            textbox = { text = "IRONROAD_WIDTH_LEGEND" size = { 390 32 } tooltip = "IRONROAD_WIDTH_TOOLTIP" using = elide_fontsize_min }
            button = {
                using = default_button
                size = { 130 32 }
                onclick = "[GetVariableSystem.Toggle('ironroad_legend_open_v1')]"
                textbox = { text = "IRONROAD_LEGEND" parentanchor = center size = { 100% 100% } align = center alwaystransparent = yes using = elide_fontsize_min }
            }
        }
        flowcontainer = {
            direction = vertical
            visible = "[GetVariableSystem.Exists('ironroad_legend_open_v1')]"
            flowcontainer = {
                spacing = 2
                widget = {
                    size = { 64 48 }
                    tooltip = "IRONROAD_WIDTH_0"
